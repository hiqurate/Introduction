# HawkSight environment configuration
# Copy to .env for local development. In production set these as
# environment variables in your hosting platform; never commit real values.

# Required in production -------------------------------------------------

NODE_ENV=production

# Session signing secret, at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# 32-byte key, base64 encoded, used to encrypt evidence files at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a secure backup: evidence cannot be decrypted without it.
EVIDENCE_ENCRYPTION_KEY=

# Postgres connection string (for example Neon). When set, the database and
# encrypted evidence are stored in Postgres and nothing is written to disk.
# Required on Vercel. Leave empty to use a local SQLite file in DATA_DIR.
DATABASE_URL=

# Directory for the SQLite database and encrypted evidence when DATABASE_URL
# is not set. On a host with a persistent disk, point this at the disk mount.
DATA_DIR=

# First platform administrator, created on first start only.
# The password must meet the policy (12+ characters, three character types,
# must not contain the email name). If omitted, a temporary password is
# printed to the server log and must be changed at first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional ---------------------------------------------------------------

# Server port (defaults to 3000)
# PORT=3000

# Maximum evidence file size in MB (default 10; 3 on Vercel, whose request
# size limit is 4.5 MB).
# EVIDENCE_MAX_MB=10

# Maximum Postgres connections per server instance (default 5).
# PG_POOL_MAX=5

# AI assistance (question explanations and executive summary drafts).
# Leave empty to disable AI features.
GROQ_API_KEY=
# AI_MODEL=llama-3.1-8b-instant

# Demonstration organisation. Seeded on first start unless disabled.
# SEED_DEMO=false
# DEMO_PASSWORD=

# Set to false only if TLS is terminated somewhere that does not set
# X-Forwarded-Proto. HTTPS is enforced in production by default.
# FORCE_HTTPS=true

# Comma-separated list of additional allowed origins for API requests.
# ALLOWED_ORIGINS=
